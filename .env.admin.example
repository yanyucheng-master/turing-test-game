# Public origin of the deployed Render web service. Do not add a trailing path.
ADMIN_REMOTE_URL=https://your-game.onrender.com

# Must exactly match CULTURE_REVIEW_TOKEN in the Render service environment.
# Use at least 24 random characters; 64 hexadecimal characters is recommended.
CULTURE_REVIEW_TOKEN=

# Local companion settings. Keep the host on 127.0.0.1.
ADMIN_LOCAL_PORT=3001
ADMIN_AUTO_OPEN=true
