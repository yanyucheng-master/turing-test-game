# ── Backend (optional; have defaults in production) ─────────────
APP_ID=turing-test
APP_SECRET=

# ── Database (optional — leave empty to skip MySQL) ─────────────
# Match/chat/finish work in memory without a DB.
# Stats persistence only runs when DATABASE_URL is set.
DATABASE_URL=

# Stable random salt used only to HMAC anonymous learning contributors.
# Required for culture-memory persistence; never expose it to the browser.
CULTURE_LEARNING_SALT=

# Shared secret accepted only by the local administrator companion and the
# review API. Set the same value in Render and .env.admin.local.
# Use 24+ random characters; 64 hexadecimal characters is recommended.
CULTURE_REVIEW_TOKEN=

# Optional isolated evaluator model; falls back to DEFAULT_AI_MODEL.
CULTURE_REVIEW_MODEL=

# ── LLM (OpenAI-compatible) — required for AI opponents ─────────
DEFAULT_AI_API_KEY=       # e.g. DeepSeek / OpenAI API key
DEFAULT_AI_BASE_URL=      # e.g. https://api.deepseek.com
DEFAULT_AI_MODEL=         # e.g. deepseek-v4-flash
LLM_PROTOCOL=openai       # openai | anthropic (single protocol; no blind dual fallback)
